# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# build artifacts & generated release manifests
/public/version.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust / tauri
src-tauri/target/
src-tauri/gen/

# desktop installer binaries (release assets, not git tracked)
public/downloads/desktop/*.msi
public/downloads/desktop/*.exe

# local assistant configs
.cline/
.clinerules

public/downloads/desktop/*.zip
desktop_installers_archive/
/logs/
*.log
docs/discharge_video_frames/
docs/user_video_analysis/
docs/user_video_analysis_2/
scripts/check_tariffs.mjs

# Database snapshot archives and manifests (strictly uncommitted, prevents PHI/PII leakage)
supabase/backups/
