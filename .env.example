# Onnesha Hospital Management & ERP System (OHMS)
# Environment Configuration Template

# -----------------------------------------------------------------------------
# 1. Browser & Desktop Public Variables (Inlined at Next.js build time)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy fallback (Supported for backward compatibility, deprecated late 2026)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------------
# 2. Server & Administrative Secrets (CI/Server-Side only, NEVER in client code)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# -----------------------------------------------------------------------------
# 3. Dedicated Staging & CI Verification Secrets (For live security gates)
# -----------------------------------------------------------------------------
OHMS_TEST_SUPABASE_URL=https://your-staging-project.supabase.co
OHMS_TEST_PUBLISHABLE_KEY=sb_publishable_test_key_here
OHMS_TEST_SECRET_KEY=sb_secret_test_key_here

# -----------------------------------------------------------------------------
# 4. Cloudflare Pages Production Deployment Credentials
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# 5. External Payment & SMS Integrations (Optional / Activation Gates)
# -----------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_SANDBOX=true

SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=
